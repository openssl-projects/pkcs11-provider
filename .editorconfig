root = true

[*]
charset = utf-8
max_line_length = 80
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{c,h,pre}]
indent_style = space
indent_size = 4
tab_width = 4

[{*.sh,tests/t*,tests/test-wrapper}]
indent_style = space
indent_size = 4
tab_width = 4

[*.py]
indent_style = space
indent_size = 4
tab_width = 4

[{meson.build,meson_options.txt}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2
tab_width = 2

[Makefile]
indent_style = tab
