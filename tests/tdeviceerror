source "${TESTSSRCDIR}/helpers.sh"

title PARA "Re-init after device error"
sed "s/pkcs11-module-quirks = /pkcs11-module-quirks = reinit-on-device-error /" \
    "${OPENSSL_CONF}" > "${OPENSSL_CONF}.deverror"
OPENSSL_CONF=${OPENSSL_CONF}.deverror

export P11SHIM_MODULE="${P11LIB}"
export PKCS11_PROVIDER_MODULE="${P11SHIM}"

$CHECKER "${TESTBLDDIR}/tdeverror"
